# Copy this file to .env and fill in real values. Do NOT commit your .env file.

# Which API provides the customer's dialogue and the evaluation. Usually you do not
# need to set this: if DEEPSEEK_API_KEY is present it uses deepseek, otherwise
# openrouter.
#   deepseek    - paid per token, no daily request cap. ~$0.0002 per reply.
#   openrouter  - free models available, but the free tier is capped at 50 requests
#                 per DAY for the whole account, across every :free model combined.
AI_PROVIDER=deepseek

# Set the key for whichever provider you use. Leaving DeepSeek's key configured and
# also keeping an OpenRouter key means a DeepSeek outage or empty balance falls
# through to OpenRouter automatically instead of breaking the simulator.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Models tried in order until one returns usable content. Leave blank to use the
# provider defaults (deepseek-chat for DeepSeek; a couple of free OpenRouter slugs
# for OpenRouter). Free OpenRouter model IDs are retired without notice — if the
# customer's replies start repeating the same 2-3 canned lines, check
# https://openrouter.ai/models for current slugs.
AI_MODELS=

# Give up on the model chain after this long so a request cannot hang.
AI_TOTAL_BUDGET_MS=25000

# Sent as HTTP-Referer to OpenRouter for usage attribution. Ignored by DeepSeek.
HTTP_REFERER=http://localhost:5000

# Max AI-backed requests per visitor IP per hour. /api/evaluate calls a model on
# every use, so this is the only real cap on cost from a public embed.
AI_RATE_LIMIT_PER_HOUR=40

# Port to run the server on (optional)
PORT=5000

# Signs session cookies against tampering. If unset, a random value is generated at
# boot — fine for local dev, but set a real value in production so sessions survive
# a restart. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
